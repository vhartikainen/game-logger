DB_ROOT_PASSWORD=rootpassword

# Host port mappings
DB_PORT=3306
WEB_PORT=8090

# DuckDNS (production only, see docker-compose.prod.yml / docker/README.md)
DUCKDNS_SUBDOMAIN=
DUCKDNS_TOKEN=
